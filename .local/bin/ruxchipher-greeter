#!/bin/sh
# ruxchipher-greeter: greet once after login, again every time the screen is unlocked,
# and show a goodbye card when the machine shuts down or restarts.
#
# The goodbye uses a logind "delay" inhibitor: when shutdown starts, logind announces
# PrepareForShutdown and waits (up to InhibitDelayMaxSec, 5 s by default) for delay locks
# to be released. We show the card, wait ~2 s, then exit, which releases the lock.
STATE="$HOME/.cache/ruxchipher/locked_at"
mkdir -p "$(dirname "$STATE")"

goodbye_watch() {
    while true; do
        systemd-inhibit --what=shutdown --mode=delay --who="ruxchipher" --why="goodbye card" sh -c '
            gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
            while read -r line; do
                case "$line" in
                    *PrepareForShutdown*true*) ruxchipher-greet bye & sleep 2.2; exit 0 ;;
                esac
            done'
        sleep 1
    done
}
goodbye_watch &

sleep 5
ruxchipher-greet login &

gdbus monitor --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver |
while read -r line; do
    case "$line" in
        *ActiveChanged*true*)  date +%s > "$STATE" ;;
        *ActiveChanged*false*) ruxchipher-greet unlock "$(cat "$STATE" 2>/dev/null || echo 0)" & ;;
    esac
done
