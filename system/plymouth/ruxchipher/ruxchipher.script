# ruxchipher boot splash (Plymouth script theme), Tokyo Night.
# Deliberately minimal: the dimmed wallpaper and the shield logo, fading in and gently glowing.
# The splash is only on screen for about a second on this laptop (Plymouth waits for the GPU
# driver), so text never had time to show; the greeting happens after login instead.

Window.SetBackgroundTopColor(0.06, 0.06, 0.09);
Window.SetBackgroundBottomColor(0.04, 0.04, 0.06);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

bg.image = Image("bg.png");
bg.sprite = Sprite(bg.image.Scale(screen.w, screen.h));
bg.sprite.SetZ(-100);

logo.size = Math.Int(screen.h * 0.22);
logo.image = Image("shield.png").Scale(logo.size, logo.size);
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(Math.Int((screen.w - logo.size) / 2), Math.Int((screen.h - logo.size) / 2), 10);
logo.sprite.SetOpacity(0);

frame = 0;

fun refresh_callback() {
    global.frame = global.frame + 1;
    f = global.frame;
    if (f < 15) logo.sprite.SetOpacity(f / 15);
    else logo.sprite.SetOpacity(0.86 + 0.14 * Math.Sin(f / 18));
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---------------------------------------------------------------- password prompts (e.g. disk encryption)
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun password_callback(text, count) {
    prompt.image = Image.Text(text, 0.75, 0.79, 0.96, 1);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(Math.Int((screen.w - prompt.image.GetWidth()) / 2), Math.Int(screen.h * 0.75), 30);
    dots = "";
    for (i = 0; i < count; i++) dots = dots + "* ";
    bullets.image = Image.Text(dots + "_", 0.49, 0.81, 1, 1);
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetPosition(Math.Int((screen.w - bullets.image.GetWidth()) / 2), Math.Int(screen.h * 0.75) + 30, 30);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);
